# ============================================================
# SwasthyaSaaS Production & Local Environment Configuration
# ============================================================

# Backend API Keys (Required on FastAPI Server environment only)
# Get a free API Key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# FastAPI Backend Server Port (Set by hosting platforms like Render, Railway, Heroku)
PORT=8000

# Frontend API URL (Set on Vercel/Netlify for Frontend deployment)
# Example: https://swasthya-api.onrender.com
# Leave empty for local Vite dev proxying
VITE_API_URL=
